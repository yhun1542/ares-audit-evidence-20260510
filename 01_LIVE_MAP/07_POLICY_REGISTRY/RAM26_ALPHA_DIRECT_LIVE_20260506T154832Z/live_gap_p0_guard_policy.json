{
  "schema": "ares_live_gap_p0_thresholds_v1",
  "goal": "Reduce live-vs-backtest gap and raise high-confidence trade win-rate by blocking low-quality live decisions.",
  "regime": {
    "canonical_ssot_key": "ctx:macro:regime",
    "legacy_key": "regime:current",
    "prefer_canonical_on_conflict": true,
    "bullish_min_score": 0.35,
    "low_confidence_score_max": 0.2,
    "clamp_low_confidence_to": "NORMAL",
    "max_leverage_when_low_confidence": 1.0,
    "vol_scale_when_low_confidence": 1.0,
    "max_leverage_bullish_cap": 1.25,
    "vol_scale_bullish_cap": 1.15
  },
  "xgb_feature_drift": {
    "block_if_abs_z_gt": 3.0,
    "block_reason": "DRIFT_BLOCKED",
    "confidence_zero_on_block": true,
    "metrics_to_scan": [
      "vol_20d",
      "ret_5d",
      "ret_20d",
      "atr_14d",
      "volume_z",
      "gap_z"
    ]
  },
  "cost_model": {
    "commission_bps_round_trip": 50.0,
    "commission_bps_per_side": 25.0,
    "slippage_bps_one_way": 12.0,
    "fallback_extra_bps_one_way": 10.0,
    "hard_fail_if_cost_model_below_live_cost": true
  },
  "pegger": {
    "fallback_adj_bp_new": 10,
    "fallback_adj_bp_old_suspect": [
      15,
      20
    ],
    "high_vol_timeout_ms": 3000,
    "timeout_count_warn": 20
  },
  "hit_rate": {
    "raw_trade_winrate_target_note": "Do not force raw all-trade win-rate. Use high-confidence post-filter lane.",
    "high_confidence_lane_min_expected_winrate": 0.75,
    "block_low_confidence_signals": true,
    "minimum_signal_confidence_for_new_orders": 0.55
  }
}