{
  "emarkos:v1:positions": {
    "type": "string",
    "writer": "kis-balance-sync",
    "schema_version": "2.0",
    "description": "Position snapshot as JSON string"
  },
  "kis:broker:positions": {
    "type": "string",
    "writer": "kis-balance-sync",
    "schema_version": "2.0",
    "description": "KIS broker positions — currently hash on server, must migrate to string"
  },
  "kis:broker:positions_sync_status": {
    "type": "string",
    "writer": "kis-balance-sync",
    "schema_version": "1.0",
    "description": "Sync heartbeat with last_sync_ts"
  },
  "policy:execution_router": {
    "type": "string",
    "writer": "deploy-script",
    "description": "Router policy JSON: {mode: disabled|shadow_only|live}",
    "allowed_values_for_mode": [
      "disabled",
      "shadow_only",
      "live"
    ],
    "note": "mode=disabled means KIS direct (pegger bypass), mode=live means pegger primary"
  },
  "ares:exec:router_mode": {
    "type": "string",
    "writer": "order-intent-executor",
    "allowed_values": [
      "disabled",
      "pegger",
      "direct",
      "degraded_direct",
      "shadow_only",
      "live"
    ],
    "description": "Runtime router mode reflecting actual execution path (disabled = KIS direct)"
  },
  "ares:exec:router_state": {
    "type": "string",
    "writer": "order-intent-executor"
  },
  "ares:exec:router_metrics": {
    "type": "string",
    "writer": "order-intent-executor"
  },
  "ofg:gate": {
    "type": "string",
    "writer": "order-flow-governor-v3",
    "allowed_values": [
      "CLOSED",
      "DEGRADED",
      "HALF_OPEN",
      "HALT",
      "OPEN",
      "THROTTLE",
      "WARN"
    ],
    "description": "OFG v3 uses ofg:gate (not ares:ofg:gate). DEPRECATED — use ofg:status.state.",
    "deprecated_since": "2026-04-21",
    "sunset_date": "2026-07-21",
    "replacement_key": "ofg:status",
    "migration_owner": "trading-platform-team",
    "migration_status": "alias-sync-active",
    "alias_sync_sidecar": "ofg-gate-alias-sync",
    "alias_writer": "ofg-gate-alias-sync",
    "observed_values": [
      "OPEN",
      "HALT"
    ]
  },
  "guardian:heartbeat": {
    "type": "string",
    "writer": "ares-process-guardian",
    "description": "JSON string heartbeat (was hash, patched to string with TTL 120s)"
  },
  "ares:positions:schema_ver": {
    "type": "string",
    "writer": "deploy-script"
  }
}
