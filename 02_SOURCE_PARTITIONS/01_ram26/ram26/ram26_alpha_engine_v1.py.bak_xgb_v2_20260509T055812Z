def now_ms() -> int:
    return int(time.time() * 1000)


def getenv_str(name: str, default: str) -> str:
    value = os.getenv(name)
    return default if value is None or value == "" else value


def getenv_bool(name: str, default: bool) -> bool:
    raw = os.getenv(name)
    if raw is None or raw == "":
        return default
    return raw.strip().lower() in {"1", "true", "yes", "y", "on"}


def getenv_float(name: str, default: float) -> float:
    raw = os.getenv(name)
    if raw is None or raw == "":
        return default
    return float(raw)


def getenv_int(name: str, default: int) -> int:
    raw = os.getenv(name)
    if raw is None or raw == "":
        return default
    return int(raw)


def decode_redis(value: Any) -> Any:
    if isinstance(value, bytes):
        return value.decode("utf-8")
    return value


def json_dumps(obj: Any) -> str:
    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def compact_float(value: float, ndigits: int = 10) -> float:
    # Avoid -0.0 and excessive JSON noise.
    rounded = round(float(value), ndigits)
    if abs(rounded) < 10 ** (-(ndigits - 1)):
        return 0.0
    return rounded


def safe_float(value: Any, default: Optional[float] = None) -> Optional[float]:
    if value is None:
        return default
    if isinstance(value, bool):
        return float(value)
    try:
        result = float(value)
    except (TypeError, ValueError):
        return default
    if math.isnan(result) or math.isinf(result):
        return default
    return result


def safe_int(value: Any, default: Optional[int] = None) -> Optional[int]:
    if value is None:
        return default
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def mean(values: Sequence[float]) -> float:
    return sum(values) / len(values) if values else 0.0


def population_std(values: Sequence[float]) -> float:
    if not values:
        return 0.0
    mu = mean(values)
    return math.sqrt(sum((x - mu) ** 2 for x in values) / len(values))


def coeff_var_abs(weights: Sequence[float]) -> float:
    values = [abs(x) for x in weights if abs(x) > 0]
    if not values:
        return 0.0
    mu = mean(values)
    if mu <= 0:
        return 0.0
    return population_std(values) / mu


def rounded_unique_count(values: Sequence[float], ndigits: int = 6) -> int:
    return len({round(abs(x), ndigits) for x in values if abs(x) > 0})


def robust_zscores(values: Sequence[float]) -> Tuple[List[float], float]:
    """Return z-scores and the raw population std.

    Standard z-scores are intentional here. The engine separately fails closed
    when dispersion is too low, so this function must never fabricate a signal.
    """
    if not values:
        return [], 0.0
    mu = mean(values)
    sd = population_std(values)
    if sd < 1e-12:
        return [0.0 for _ in values], sd
    return [(x - mu) / sd for x in values], sd


def percentile(values: Sequence[float], q: float) -> float:
    if not values:
        return 0.0
    ordered = sorted(values)
    pos = (len(ordered) - 1) * min(max(q, 0.0), 1.0)
    lo = int(math.floor(pos))
    hi = int(math.ceil(pos))
    if lo == hi:
        return ordered[lo]
    frac = pos - lo
    return ordered[lo] * (1 - frac) + ordered[hi] * frac


def sha256_12(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]


def eprint(message: str) -> None:
    print(message, file=sys.stderr, flush=True)


