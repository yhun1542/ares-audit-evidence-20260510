class EngineConfig:
    redis_url: str = field(default_factory=lambda: getenv_str("RAM26_REDIS_URL", "redis://127.0.0.1:6379/0"))
    universe_key: str = field(default_factory=lambda: getenv_str("RAM26_UNIVERSE_KEY", "ram26:universe:v1"))
    features_key: str = field(default_factory=lambda: getenv_str("RAM26_FEATURES_KEY", "ram26:features:v1"))
    output_key: str = field(default_factory=lambda: getenv_str("RAM26_OUTPUT_KEY", "ram26:alpha:targets:v1:latest"))
    stream_key: str = field(default_factory=lambda: getenv_str("RAM26_STREAM_KEY", "ram26:alpha:targets:v1:stream"))
    heartbeat_key: str = field(default_factory=lambda: getenv_str("RAM26_HEARTBEAT_KEY", "ram26:alpha:engine:v1:heartbeat"))
    ssot_staged_key: str = field(default_factory=lambda: getenv_str("RAM26_SSOT_STAGED_KEY", "ram26:ssot:target:v2:staged"))
    ssot_current_key: str = field(default_factory=lambda: getenv_str("RAM26_SSOT_CURRENT_KEY", "ssot:target:v2:current"))
    trading_enabled_key: str = field(default_factory=lambda: getenv_str("RAM26_TRADING_ENABLED_KEY", "trading:enabled"))
    mode_key: str = field(default_factory=lambda: getenv_str("RAM26_MODE_KEY", "mode"))

    target_gross: float = field(default_factory=lambda: getenv_float("RAM26_TARGET_GROSS", 0.75))
    max_weight: float = field(default_factory=lambda: getenv_float("RAM26_MAX_WEIGHT", 0.12))
    min_active: int = field(default_factory=lambda: getenv_int("RAM26_MIN_ACTIVE", 4))
    min_cv: float = field(default_factory=lambda: getenv_float("RAM26_MIN_CV", 0.30))
    min_unique_weights: int = field(default_factory=lambda: getenv_int("RAM26_MIN_UNIQUE_WEIGHTS", 4))
    active_fraction: float = field(default_factory=lambda: getenv_float("RAM26_ACTIVE_FRACTION", 0.70))
    softmax_beta: float = field(default_factory=lambda: getenv_float("RAM26_SOFTMAX_BETA", 1.15))
    gross_tolerance: float = field(default_factory=lambda: getenv_float("RAM26_GROSS_TOLERANCE", 0.0005))

    max_spread_bps: float = field(default_factory=lambda: getenv_float("RAM26_MAX_SPREAD_BPS", 250.0))
    min_liquidity_score: float = field(default_factory=lambda: getenv_float("RAM26_MIN_LIQUIDITY_SCORE", -999.0))
    feature_max_age_sec: int = field(default_factory=lambda: getenv_int("RAM26_FEATURE_MAX_AGE_SEC", 900))
    ttl_sec: int = field(default_factory=lambda: getenv_int("RAM26_OUTPUT_TTL_SEC", 60))
    cycle_sec: float = field(default_factory=lambda: getenv_float("RAM26_CYCLE_SEC", 5.0))
    strict_freshness: bool = field(default_factory=lambda: getenv_bool("RAM26_STRICT_FRESHNESS", True))

    publish_redis: bool = field(default_factory=lambda: getenv_bool("RAM26_PUBLISH_REDIS", False))
    publish_ssot_staged: bool = field(default_factory=lambda: getenv_bool("RAM26_PUBLISH_SSOT_STAGED", False))
    publish_ssot_current: bool = field(default_factory=lambda: getenv_bool("RAM26_PUBLISH_SSOT_CURRENT", False))
    allow_current_ssot_write: bool = field(default_factory=lambda: getenv_bool("RAM26_ALLOW_CURRENT_SSOT_WRITE", False))
    allow_live_ssot_write: bool = field(default_factory=lambda: getenv_bool("RAM26_ALLOW_LIVE_SSOT_WRITE", False))

    input_json: Optional[str] = None
    output_json: Optional[str] = None

    @classmethod
    def from_args(cls, args: argparse.Namespace) -> "EngineConfig":
        base = cls()
        updates: Dict[str, Any] = {}
        for attr in (
            "redis_url",
            "universe_key",
            "features_key",
            "output_key",
            "stream_key",
            "heartbeat_key",
            "ssot_staged_key",
            "ssot_current_key",
            "target_gross",
            "max_weight",
            "min_active",
            "min_cv",
            "min_unique_weights",
            "active_fraction",
            "softmax_beta",
            "feature_max_age_sec",
            "ttl_sec",
            "cycle_sec",
            "input_json",
            "output_json",
        ):
            value = getattr(args, attr, None)
            if value is not None:
                updates[attr] = value

        # Boolean CLI flags override environment only when supplied.
        if args.publish_redis:
            updates["publish_redis"] = True
        if args.publish_ssot_staged:
            updates["publish_ssot_staged"] = True
        if args.publish_ssot_current:
            updates["publish_ssot_current"] = True
        if args.allow_current_ssot_write:
            updates["allow_current_ssot_write"] = True
        if args.allow_live_ssot_write:
            updates["allow_live_ssot_write"] = True
        if args.strict_freshness:
            updates["strict_freshness"] = True
        if args.no_strict_freshness:
            updates["strict_freshness"] = False

        return EngineConfig(**{**base.__dict__, **updates})

    def validate(self) -> None:
        if not (0 < self.target_gross <= 1.5):
            raise ValueError(f"invalid target_gross={self.target_gross}")
        if not (0 < self.max_weight <= self.target_gross):
            raise ValueError(f"invalid max_weight={self.max_weight}")
        if self.min_active < 1:
            raise ValueError("min_active must be >= 1")
        if self.min_cv < 0:
            raise ValueError("min_cv must be >= 0")
        if self.min_unique_weights < 1:
            raise ValueError("min_unique_weights must be >= 1")
        if not (0 < self.active_fraction <= 1):
            raise ValueError("active_fraction must be in (0, 1]")
        if self.softmax_beta <= 0:
            raise ValueError("softmax_beta must be > 0")

        minimum_positions_for_cap = math.ceil(self.target_gross / self.max_weight)
        if self.min_active < minimum_positions_for_cap:
            # Not an error. The constructor will auto-raise active count. This log is useful for ops.
            eprint(
                f"[RAM26_CONFIG_NOTE] min_active={self.min_active} is below cap-implied minimum "
                f"{minimum_positions_for_cap}; engine will require at least {minimum_positions_for_cap} active names"
            )

        if self.publish_ssot_current and not self.allow_current_ssot_write:
            raise ValueError(
                "publish_ssot_current requires --allow-current-ssot-write. "
                "Default behavior intentionally avoids ssot:target:v2:current."
            )


