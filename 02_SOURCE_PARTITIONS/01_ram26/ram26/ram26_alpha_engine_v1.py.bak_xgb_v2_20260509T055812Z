def self_test_records() -> List[FeatureRecord]:
    ts = now_ms()
    raw_records: List[Dict[str, Any]] = []
    # Deterministic, deliberately non-flat feature set.
    for i in range(18):
        strength = (17 - i) / 17.0
        raw_records.append(
            {
                "symbol": f"RAM26_TEST_{i + 1:02d}",
                "ret_1d": 0.002 * math.sin(i),
                "ret_5d": 0.01 * (strength - 0.35),
                "ret_20d": 0.04 * (strength - 0.20),
                "ret_60d": 0.08 * (strength - 0.25),
                "vol_20d": 0.12 + 0.015 * i,
                "vol_60d": 0.15 + 0.012 * i,
                "quality": 1.0 - 0.04 * i,
                "value": 0.3 + 0.03 * (17 - i),
                "liquidity": 1.0,
                "sentiment": 0.1 * math.cos(i / 3.0),
                "drawdown_20d": -0.01 * i,
                "spread_bps": 10 + i,
                "price": 100 + i,
                "updated_at_ms": ts,
                "eligible": True,
            }
        )
    return [FeatureRecord.from_mapping(x) for x in raw_records]


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


_STOP = False


def handle_stop_signal(signum: int, frame: Any) -> None:  # pragma: no cover - signal glue
    global _STOP
    _STOP = True
    eprint(f"[RAM26_ENGINE_STOP_REQUESTED] signal={signum}")


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="RAM26 Alpha Engine v1 - fail-closed target generator")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--once", action="store_true", help="run a single cycle")
    mode.add_argument("--loop", action="store_true", help="run continuously")
    mode.add_argument("--self-test", action="store_true", help="run deterministic self-test and print JSON")

    parser.add_argument("--input-json", help="load feature records from local JSON instead of Redis")
    parser.add_argument("--output-json", help="write generated payload to local JSON")

    parser.add_argument("--redis-url", help="Redis URL")
    parser.add_argument("--universe-key", help="Redis universe key")
    parser.add_argument("--features-key", help="Redis features key")
    parser.add_argument("--output-key", help="Redis RAM26 output key")
    parser.add_argument("--stream-key", help="Redis RAM26 stream key")
    parser.add_argument("--heartbeat-key", help="Redis RAM26 heartbeat key")
    parser.add_argument("--ssot-staged-key", help="Redis staged SSOT key")
    parser.add_argument("--ssot-current-key", help="Redis current SSOT key")

    parser.add_argument("--target-gross", type=float, help="target gross exposure")
    parser.add_argument("--max-weight", type=float, help="max single-name weight")
    parser.add_argument("--min-active", type=int, help="minimum active positions")
    parser.add_argument("--min-cv", type=float, help="minimum output weight CV")
    parser.add_argument("--min-unique-weights", type=int, help="minimum unique nonzero weights rounded to 6dp")
    parser.add_argument("--active-fraction", type=float, help="fraction of eligible universe selected")
    parser.add_argument("--softmax-beta", type=float, help="softmax dispersion beta")
    parser.add_argument("--feature-max-age-sec", type=int, help="freshness guard in seconds")
    parser.add_argument("--ttl-sec", type=int, help="Redis output TTL seconds")
    parser.add_argument("--cycle-sec", type=float, help="loop cycle seconds")

    parser.add_argument("--publish-redis", action="store_true", help="publish payload to Redis output key")
    parser.add_argument("--publish-ssot-staged", action="store_true", help="also publish PASS payload to staged SSOT key")
    parser.add_argument("--publish-ssot-current", action="store_true", help="also publish PASS payload to ssot:target:v2:current")
    parser.add_argument("--allow-current-ssot-write", action="store_true", help="explicit unlock for current SSOT writes")
    parser.add_argument("--allow-live-ssot-write", action="store_true", help="permit current SSOT writes even if mode/LIVE flags appear enabled")
    parser.add_argument("--strict-freshness", action="store_true", help="require updated_at_ms and max age")
    parser.add_argument("--no-strict-freshness", action="store_true", help="disable updated_at_ms freshness guard")

    return parser.parse_args(argv)


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_args(argv)
    cfg = EngineConfig.from_args(args)
    cfg.validate()

    if args.self_test:
        test_cfg = EngineConfig(**{**cfg.__dict__, "strict_freshness": True, "publish_redis": False})
        result = run_cycle(test_cfg, records_override=self_test_records())
        print(json.dumps(result.payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if result.ok else 2

    # Default to one-shot unless --loop was explicitly requested.
    run_loop = bool(args.loop)
    client = None
    if cfg.publish_redis or (not cfg.input_json):
        client = connect_redis(cfg.redis_url)

    if not run_loop:
        result = run_cycle(cfg, client=client)
        if not cfg.output_json:
            print(json.dumps(result.payload, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if result.ok else 2

    signal.signal(signal.SIGINT, handle_stop_signal)
    signal.signal(signal.SIGTERM, handle_stop_signal)
    eprint(
        f"[RAM26_ENGINE_START] engine_id={ENGINE_ID} loop=1 cycle_sec={cfg.cycle_sec} "
        f"features_key={cfg.features_key} output_key={cfg.output_key} publish_redis={cfg.publish_redis}"
    )
    exit_code = 0
    while not _STOP:
        result = run_cycle(cfg, client=client)
        if not result.ok:
            exit_code = 2
        time.sleep(max(0.5, cfg.cycle_sec))
    eprint("[RAM26_ENGINE_STOPPED]")
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
