# Alpha and portfolio construction
# ---------------------------------------------------------------------------


@dataclass
class ScoredRecord:
    record: FeatureRecord
    score: float
    components: Dict[str, float]


@dataclass
class EngineResult:
    ok: bool
    payload: Dict[str, Any]
    reason: Optional[str] = None


class FailClosed(Exception):
    """Raised when the engine must refuse to publish tradeable targets."""


def vector(records: Sequence[FeatureRecord], attr: str) -> List[float]:
    return [float(getattr(record, attr)) for record in records]


def score_records(records: Sequence[FeatureRecord]) -> Tuple[List[ScoredRecord], Dict[str, Any]]:
    if not records:
        raise FailClosed("no_eligible_records")

    attrs = [
        "ret_1d",
        "ret_5d",
        "ret_20d",
        "ret_60d",
        "vol_20d",
        "vol_60d",
        "quality",
        "value",
        "liquidity",
        "sentiment",
        "drawdown_20d",
    ]

    zmap: Dict[str, List[float]] = {}
    stdmap: Dict[str, float] = {}
    for attr in attrs:
        z, sd = robust_zscores(vector(records, attr))
        zmap[attr] = z
        stdmap[attr] = sd

    # Composite model. The exact weights are intentionally simple and explicit.
    # Negative risk terms penalize high volatility and deep drawdown. If drawdown is
    # stored as a negative number, abs(drawdown) is used before z-scoring below.
    abs_dd_values = [abs(r.drawdown_20d) for r in records]
    z_dd_abs, sd_dd_abs = robust_zscores(abs_dd_values)
    stdmap["abs_drawdown_20d"] = sd_dd_abs

    scored: List[ScoredRecord] = []
    for i, record in enumerate(records):
        components = {
            "mom_1d": 0.05 * zmap["ret_1d"][i],
            "mom_5d": 0.10 * zmap["ret_5d"][i],
            "mom_20d": 0.28 * zmap["ret_20d"][i],
            "mom_60d": 0.18 * zmap["ret_60d"][i],
            "quality": 0.14 * zmap["quality"][i],
            "value": 0.08 * zmap["value"][i],
            "sentiment": 0.07 * zmap["sentiment"][i],
            "liquidity": 0.05 * zmap["liquidity"][i],
            "vol_penalty_20d": -0.16 * zmap["vol_20d"][i],
            "vol_penalty_60d": -0.06 * zmap["vol_60d"][i],
            "drawdown_penalty": -0.10 * z_dd_abs[i],
        }
        score = sum(components.values())
        scored.append(ScoredRecord(record=record, score=score, components=components))

    raw_scores = [item.score for item in scored]
    score_std = population_std(raw_scores)
    score_cv = coeff_var_abs(raw_scores)
    meta = {
        "feature_std": {k: compact_float(v, 8) for k, v in stdmap.items()},
        "score_std": compact_float(score_std, 8),
        "score_cv_abs": compact_float(score_cv, 8),
    }
    if score_std < 1e-10:
        raise FailClosed("flat_alpha_score_std")

    return scored, meta


def select_active(scored: Sequence[ScoredRecord], cfg: EngineConfig) -> List[ScoredRecord]:
    if not scored:
        raise FailClosed("no_scored_records")

    ordered = sorted(scored, key=lambda x: (x.score, x.record.symbol), reverse=True)
    n = len(ordered)
    cap_min = math.ceil(cfg.target_gross / cfg.max_weight)
    required_min = max(cfg.min_active, cap_min)
    fractional = max(required_min, int(math.ceil(n * cfg.active_fraction)))
    active_count = min(n, fractional)

    if active_count < required_min:
        raise FailClosed(f"insufficient_active_after_cap_requirement active={active_count} required={required_min}")

    selected = ordered[:active_count]

    # Refuse to manufacture a long book when every selected alpha is non-positive.
    if max(item.score for item in selected) <= 0:
        raise FailClosed("no_positive_alpha_leader")

    return selected


def softmax_weights(selected: Sequence[ScoredRecord], cfg: EngineConfig) -> Dict[str, float]:
    scores = [item.score for item in selected]
    zscores, score_sd = robust_zscores(scores)
    if score_sd < 1e-12:
        raise FailClosed("selected_scores_flat")

    # Shift by max for numerical stability. beta controls dispersion; it is not a
    # fallback and cannot save a flat selected_scores vector due to the guard above.
    scaled = [cfg.softmax_beta * z for z in zscores]
    max_scaled = max(scaled)
    exp_values = [math.exp(x - max_scaled) for x in scaled]
    denom = sum(exp_values)
    if denom <= 0:
        raise FailClosed("softmax_denominator_zero")

    raw = {item.record.symbol: (v / denom) * cfg.target_gross for item, v in zip(selected, exp_values)}
    return cap_and_rescale(raw, cfg)


def cap_and_rescale(weights: Mapping[str, float], cfg: EngineConfig) -> Dict[str, float]:
    remaining = {symbol: max(0.0, float(weight)) for symbol, weight in weights.items()}
    capped: Dict[str, float] = {}

    for _ in range(len(remaining) + 2):
        if not remaining:
            break
        total_remaining = sum(remaining.values())
        if total_remaining <= 0:
            break
        scale = max(0.0, (cfg.target_gross - sum(capped.values())) / total_remaining)
        changed = False
        next_remaining: Dict[str, float] = {}
        for symbol, weight in remaining.items():
            candidate = weight * scale
            if candidate > cfg.max_weight:
                capped[symbol] = cfg.max_weight
                changed = True
            else:
                next_remaining[symbol] = weight
        remaining = next_remaining
        if not changed:
            for symbol, weight in remaining.items():
                capped[symbol] = weight * scale
            remaining = {}
            break

    gross = sum(capped.values())
    if abs(gross - cfg.target_gross) > cfg.gross_tolerance:
        raise FailClosed(f"cannot_reach_target_gross_after_cap gross={gross:.8f}")

    # Remove numerical dust and normalize once more without violating cap materially.
    normalized = {symbol: compact_float(weight, 10) for symbol, weight in capped.items() if weight > 0}
    gross2 = sum(normalized.values())
    if gross2 <= 0:
        raise FailClosed("zero_gross_after_normalization")
    adjust = cfg.target_gross / gross2
    normalized = {symbol: compact_float(weight * adjust, 10) for symbol, weight in normalized.items()}

    if any(weight > cfg.max_weight + 1e-8 for weight in normalized.values()):
        raise FailClosed("max_weight_violation_after_normalization")

    return dict(sorted(normalized.items(), key=lambda item: item[1], reverse=True))


def dispersion_guard(weights: Mapping[str, float], cfg: EngineConfig) -> Dict[str, Any]:
    values = list(weights.values())
    gross = sum(abs(x) for x in values)
    cv = coeff_var_abs(values)
    unique = rounded_unique_count(values, 6)
    active = len(values)
    max_w = max(values) if values else 0.0
    min_w = min(values) if values else 0.0

    metrics = {
        "gross": compact_float(gross, 10),
        "cv": compact_float(cv, 6),
        "unique_weight_count_6dp": unique,
        "active_count": active,
        "max_weight": compact_float(max_w, 10),
        "min_weight": compact_float(min_w, 10),
        "max_over_min": compact_float(max_w / min_w, 6) if min_w > 0 else None,
    }

    if abs(gross - cfg.target_gross) > cfg.gross_tolerance:
        raise FailClosed(f"gross_guard_failed gross={gross:.10f} target={cfg.target_gross}")
    if active < cfg.min_active:
        raise FailClosed(f"active_guard_failed active={active} min={cfg.min_active}")
    if unique < cfg.min_unique_weights:
        raise FailClosed(f"unique_weight_guard_failed unique={unique} min={cfg.min_unique_weights}")
    if cv < cfg.min_cv:
        raise FailClosed(f"cv_guard_failed cv={cv:.6f} min={cfg.min_cv}")

    return metrics


