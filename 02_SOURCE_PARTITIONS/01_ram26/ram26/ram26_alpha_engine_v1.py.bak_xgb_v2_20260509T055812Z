def normalize_feature_payload(payload: Any) -> List[FeatureRecord]:
    records: List[FeatureRecord] = []

    if isinstance(payload, list):
        for item in payload:
            if not isinstance(item, Mapping):
                raise ValueError("feature list must contain JSON objects")
            records.append(FeatureRecord.from_mapping(item))
        return records

    if isinstance(payload, Mapping):
        # Common wrappers.
        for wrapper_key in ("features", "records", "data", "symbols"):
            wrapped = payload.get(wrapper_key)
            if isinstance(wrapped, list):
                return normalize_feature_payload(wrapped)

        # Either {"005930": {...}} or a single record with symbol.
        if any(k in payload for k in SYMBOL_ALIASES):
            return [FeatureRecord.from_mapping(payload)]

        for symbol, value in payload.items():
            if isinstance(value, Mapping):
                records.append(FeatureRecord.from_mapping(value, fallback_symbol=str(symbol)))
            else:
                raise ValueError(f"feature map value for {symbol!r} must be object")
        return records

    raise ValueError("unsupported feature payload format")


def load_features_from_file(path: str) -> List[FeatureRecord]:
    with open(path, "r", encoding="utf-8") as f:
        payload = json.load(f)
    return normalize_feature_payload(payload)


def import_redis_module() -> Any:
    try:
        import redis  # type: ignore
    except ImportError as exc:
        raise RuntimeError(
            "redis package is required for Redis mode. Install redis-py or use --input-json for file mode."
        ) from exc
    return redis


def connect_redis(redis_url: str) -> Any:
    redis = import_redis_module()
    client = redis.Redis.from_url(redis_url, socket_timeout=3, socket_connect_timeout=3)
    client.ping()
    return client


def load_features_from_redis(client: Any, cfg: EngineConfig) -> List[FeatureRecord]:
    key_type_raw = client.type(cfg.features_key)
    key_type = decode_redis(key_type_raw)

    if key_type == "none":
        raise RuntimeError(f"features key does not exist: {cfg.features_key}")

    if key_type == "hash":
        raw_map = client.hgetall(cfg.features_key)
        decoded: Dict[str, Any] = {}
        for raw_symbol, raw_json in raw_map.items():
            symbol = decode_redis(raw_symbol)
            value_text = decode_redis(raw_json)
            value = json.loads(value_text)
            if not isinstance(value, Mapping):
                raise ValueError(f"hash field {symbol!r} must contain a JSON object")
            decoded[symbol] = value
        return normalize_feature_payload(decoded)

    if key_type == "string":
        raw = client.get(cfg.features_key)
        if raw is None:
            raise RuntimeError(f"features key is empty: {cfg.features_key}")
        return normalize_feature_payload(json.loads(decode_redis(raw)))

    raise RuntimeError(f"unsupported Redis type for {cfg.features_key}: {key_type}")


