FLOAT_ALIASES: Dict[str, Tuple[str, ...]] = {
    "ret_1d": ("ret_1d", "return_1d", "mom_1d", "momentum_1d"),
    "ret_5d": ("ret_5d", "return_5d", "mom_5d", "momentum_5d"),
    "ret_20d": ("ret_20d", "return_20d", "mom_20d", "momentum_20d"),
    "ret_60d": ("ret_60d", "return_60d", "mom_60d", "momentum_60d"),
    "vol_20d": ("vol_20d", "volatility_20d", "risk_20d", "sigma_20d"),
    "vol_60d": ("vol_60d", "volatility_60d", "risk_60d", "sigma_60d"),
    "quality": ("quality", "quality_score", "q_score"),
    "value": ("value", "value_score", "v_score"),
    "liquidity": ("liquidity", "liquidity_score", "liq_score", "adv_score"),
    "sentiment": ("sentiment", "sentiment_score", "news_score"),
    "drawdown_20d": ("drawdown_20d", "max_drawdown_20d", "mdd_20d"),
    "spread_bps": ("spread_bps", "bid_ask_spread_bps", "spread"),
    "price": ("price", "last", "last_price", "close", "close_price"),
}

SYMBOL_ALIASES = ("symbol", "ticker", "code", "asset", "instrument")
UPDATED_AT_ALIASES = ("updated_at_ms", "features_updated_at_ms", "ts_ms", "timestamp_ms", "generated_at_ms")


@dataclass
class FeatureRecord:
    symbol: str
    raw: Dict[str, Any]
    ret_1d: float = 0.0
    ret_5d: float = 0.0
    ret_20d: float = 0.0
    ret_60d: float = 0.0
    vol_20d: float = 0.0
    vol_60d: float = 0.0
    quality: float = 0.0
    value: float = 0.0
    liquidity: float = 0.0
    sentiment: float = 0.0
    drawdown_20d: float = 0.0
    spread_bps: float = 0.0
    price: Optional[float] = None
    updated_at_ms: Optional[int] = None
    eligible: bool = True
    reject_reason: Optional[str] = None

    @staticmethod
    def _get_float(data: Mapping[str, Any], aliases: Sequence[str], default: float = 0.0) -> float:
        for key in aliases:
            if key in data:
                value = safe_float(data.get(key), None)
                if value is not None:
                    return value
        return default

    @staticmethod
    def _get_optional_float(data: Mapping[str, Any], aliases: Sequence[str]) -> Optional[float]:
        for key in aliases:
            if key in data:
                value = safe_float(data.get(key), None)
                if value is not None:
                    return value
        return None

    @staticmethod
    def _get_symbol(data: Mapping[str, Any], fallback_symbol: Optional[str] = None) -> Optional[str]:
        for key in SYMBOL_ALIASES:
            value = data.get(key)
            if isinstance(value, str) and value.strip():
                return value.strip()
        return fallback_symbol

    @staticmethod
    def _get_updated_at_ms(data: Mapping[str, Any]) -> Optional[int]:
        for key in UPDATED_AT_ALIASES:
            value = safe_int(data.get(key), None)
            if value is not None:
                # Accept seconds timestamps and convert to ms when clearly needed.
                if 1_000_000_000 <= value < 10_000_000_000:
                    return value * 1000
                return value
        return None

    @classmethod
    def from_mapping(cls, data: Mapping[str, Any], fallback_symbol: Optional[str] = None) -> "FeatureRecord":
        symbol = cls._get_symbol(data, fallback_symbol)
        if not symbol:
            raise ValueError(f"feature record missing symbol: {data}")
        record = cls(
            symbol=symbol,
            raw=dict(data),
            ret_1d=cls._get_float(data, FLOAT_ALIASES["ret_1d"]),
            ret_5d=cls._get_float(data, FLOAT_ALIASES["ret_5d"]),
            ret_20d=cls._get_float(data, FLOAT_ALIASES["ret_20d"]),
            ret_60d=cls._get_float(data, FLOAT_ALIASES["ret_60d"]),
            vol_20d=cls._get_float(data, FLOAT_ALIASES["vol_20d"]),
            vol_60d=cls._get_float(data, FLOAT_ALIASES["vol_60d"]),
            quality=cls._get_float(data, FLOAT_ALIASES["quality"]),
            value=cls._get_float(data, FLOAT_ALIASES["value"]),
            liquidity=cls._get_float(data, FLOAT_ALIASES["liquidity"]),
            sentiment=cls._get_float(data, FLOAT_ALIASES["sentiment"]),
            drawdown_20d=cls._get_float(data, FLOAT_ALIASES["drawdown_20d"]),
            spread_bps=cls._get_float(data, FLOAT_ALIASES["spread_bps"]),
            price=cls._get_optional_float(data, FLOAT_ALIASES["price"]),
            updated_at_ms=cls._get_updated_at_ms(data),
        )

        raw_eligible = data.get("eligible", True)
        if isinstance(raw_eligible, str):
            record.eligible = raw_eligible.strip().lower() not in {"0", "false", "no", "n"}
        else:
            record.eligible = bool(raw_eligible)

        if data.get("halted") or data.get("suspended") or data.get("blocked"):
            record.eligible = False
            record.reject_reason = "halted_or_blocked"
        return record

    def apply_risk_filters(self, cfg: EngineConfig, ts_ms: int) -> None:
        if not self.eligible:
            if self.reject_reason is None:
                self.reject_reason = "ineligible_flag"
            return

        if self.price is not None and self.price <= 0:
            self.eligible = False
            self.reject_reason = "non_positive_price"
            return

        if self.spread_bps > cfg.max_spread_bps:
            self.eligible = False
            self.reject_reason = f"spread_bps>{cfg.max_spread_bps}"
            return

        if self.liquidity < cfg.min_liquidity_score:
            self.eligible = False
            self.reject_reason = f"liquidity<{cfg.min_liquidity_score}"
            return

        if cfg.strict_freshness:
            if self.updated_at_ms is None:
                self.eligible = False
                self.reject_reason = "missing_updated_at_ms"
                return
            age_sec = max(0.0, (ts_ms - self.updated_at_ms) / 1000.0)
            if age_sec > cfg.feature_max_age_sec:
                self.eligible = False
                self.reject_reason = f"stale_features_age_sec={round(age_sec, 1)}"
                return


