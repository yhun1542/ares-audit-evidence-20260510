def build_pass_payload(
    cfg: EngineConfig,
    all_records: Sequence[FeatureRecord],
    eligible_records: Sequence[FeatureRecord],
    scored: Sequence[ScoredRecord],
    selected: Sequence[ScoredRecord],
    weights: Mapping[str, float],
    dispersion: Mapping[str, Any],
    score_meta: Mapping[str, Any],
    ts_ms: int,
) -> Dict[str, Any]:
    scored_by_symbol = {item.record.symbol: item for item in scored}
    selected_symbols = [item.record.symbol for item in selected]
    ordered_symbols = list(weights.keys())

    reject_counts: Dict[str, int] = {}
    for record in all_records:
        if not record.eligible:
            reason = record.reject_reason or "unknown"
            reject_counts[reason] = reject_counts.get(reason, 0) + 1

    target_rows = []
    for rank, symbol in enumerate(ordered_symbols, start=1):
        item = scored_by_symbol[symbol]
        target_rows.append(
            {
                "symbol": symbol,
                "weight": compact_float(weights[symbol], 10),
                "score": compact_float(item.score, 8),
                "rank": rank,
                "features_updated_at_ms": item.record.updated_at_ms,
            }
        )

    # The candidate id must change when the actual target vector changes.
    candidate_material = json_dumps({"weights": weights, "ts_bucket": ts_ms // 1000})
    candidate_id = f"ram26_v1_{sha256_12(candidate_material)}"

    payload: Dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "status": "PASS",
        "engine_id": ENGINE_ID,
        "generator": ENGINE_ID,
        "champion_candidate_id": candidate_id,
        "generated_at_ms": ts_ms,
        "ttl_ms": cfg.ttl_sec * 1000,
        "target_gross": compact_float(cfg.target_gross, 10),
        "target_type": "long_only_target_weights",
        "universe_count": len(all_records),
        "eligible_count": len(eligible_records),
        "active_count": len(weights),
        "selected_symbols": selected_symbols,
        "weights": {symbol: compact_float(weight, 10) for symbol, weight in weights.items()},
        "targets": target_rows,
        "dispersion": dict(dispersion),
        "alpha_model": {
            "name": "ram26_composite_momentum_quality_risk_v1",
            "score_meta": dict(score_meta),
            "selection": {
                "active_fraction": cfg.active_fraction,
                "softmax_beta": cfg.softmax_beta,
                "max_weight": cfg.max_weight,
                "min_active": cfg.min_active,
            },
        },
        "risk": {
            "fail_closed": True,
            "no_equal_weight_fallback": True,
            "strict_freshness": cfg.strict_freshness,
            "feature_max_age_sec": cfg.feature_max_age_sec,
            "reject_counts": reject_counts,
        },
        "bridge_weight_contract": {
            "name": BRIDGE_CONTRACT_NAME,
            "version": BRIDGE_CONTRACT_VERSION,
            "schema_version": SCHEMA_VERSION,
            "target_gross": compact_float(cfg.target_gross, 10),
            "min_cv": compact_float(cfg.min_cv, 6),
            "min_unique_weights": cfg.min_unique_weights,
            "no_equal_weight_fallback": True,
            "fail_closed_on_flat_signal": True,
            "preserve_dispersion_required": True,
        },
        "source_keys": {
            "features_key": cfg.features_key,
            "universe_key": cfg.universe_key,
        },
    }
    return payload


def build_fail_payload(cfg: EngineConfig, reason: str, ts_ms: Optional[int] = None, extra: Optional[Mapping[str, Any]] = None) -> Dict[str, Any]:
    t = ts_ms if ts_ms is not None else now_ms()
    payload: Dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "status": "FAIL_CLOSED",
        "engine_id": ENGINE_ID,
        "generator": ENGINE_ID,
        "generated_at_ms": t,
        "ttl_ms": min(cfg.ttl_sec, 30) * 1000,
        "reason": reason,
        "weights": {},
        "targets": [],
        "risk": {
            "fail_closed": True,
            "no_equal_weight_fallback": True,
        },
        "bridge_weight_contract": {
            "name": BRIDGE_CONTRACT_NAME,
            "version": BRIDGE_CONTRACT_VERSION,
            "schema_version": SCHEMA_VERSION,
            "no_equal_weight_fallback": True,
            "fail_closed_on_flat_signal": True,
            "preserve_dispersion_required": True,
        },
    }
    if extra:
        payload["extra"] = dict(extra)
    return payload


def current_system_is_live(client: Any, cfg: EngineConfig) -> bool:
    trading_enabled = decode_redis(client.get(cfg.trading_enabled_key))
    mode = decode_redis(client.get(cfg.mode_key))
    trading_true = str(trading_enabled).strip().lower() in {"1", "true", "yes", "on"}
    mode_live = str(mode).strip().upper() == "LIVE"
    return trading_true or mode_live


def publish_payload(client: Any, cfg: EngineConfig, payload: Mapping[str, Any]) -> None:
    text = json_dumps(payload)
    status = payload.get("status")

    # Main RAM26 output key. FAIL_CLOSED is also published so monitors can see why no tradeable target exists.
    client.set(cfg.output_key, text, ex=cfg.ttl_sec)
    try:
        client.xadd(cfg.stream_key, {"payload": text, "status": str(status)}, maxlen=1000, approximate=True)
    except Exception as exc:  # Redis streams may be disabled on some installations.
        eprint(f"[RAM26_STREAM_WARN] {type(exc).__name__}: {exc}")

    heartbeat = {
        "engine_id": ENGINE_ID,
        "status": status,
        "generated_at_ms": payload.get("generated_at_ms"),
        "output_key": cfg.output_key,
    }
    client.set(cfg.heartbeat_key, json_dumps(heartbeat), ex=max(cfg.ttl_sec * 2, 30))

    if status != "PASS":
        return

    if cfg.publish_ssot_staged:
        client.set(cfg.ssot_staged_key, text, ex=cfg.ttl_sec)

    if cfg.publish_ssot_current:
        if not cfg.allow_current_ssot_write:
            raise RuntimeError("current SSOT write was requested without explicit unlock")
        if current_system_is_live(client, cfg) and not cfg.allow_live_ssot_write:
            raise RuntimeError("refusing current SSOT write while trading appears LIVE; use staged key or explicit live unlock")
        client.set(cfg.ssot_current_key, text, ex=cfg.ttl_sec)


def write_output_file(path: str, payload: Mapping[str, Any]) -> None:
    tmp_path = f"{path}.tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, sort_keys=True, indent=2)
        f.write("\n")
    os.replace(tmp_path, path)


# ---------------------------------------------------------------------------
# Engine cycle
# ---------------------------------------------------------------------------


def run_cycle(cfg: EngineConfig, client: Any = None, records_override: Optional[List[FeatureRecord]] = None) -> EngineResult:
    ts = now_ms()
    try:
        if records_override is not None:
            records = records_override
        elif cfg.input_json:
            records = load_features_from_file(cfg.input_json)
        else:
            if client is None:
                raise RuntimeError("Redis client required when --input-json is not provided")
            records = load_features_from_redis(client, cfg)

        for record in records:
            record.apply_risk_filters(cfg, ts)
        eligible = [record for record in records if record.eligible]
        if len(eligible) < max(cfg.min_active, math.ceil(cfg.target_gross / cfg.max_weight)):
            raise FailClosed(
                f"insufficient_eligible_records eligible={len(eligible)} required={max(cfg.min_active, math.ceil(cfg.target_gross / cfg.max_weight))}"
            )

        scored, score_meta = score_records(eligible)
        selected = select_active(scored, cfg)
        weights = softmax_weights(selected, cfg)
        dispersion = dispersion_guard(weights, cfg)

        payload = build_pass_payload(cfg, records, eligible, scored, selected, weights, dispersion, score_meta, ts)

        input_cv = compact_float(score_meta.get("score_cv_abs", 0.0), 6)
        output_cv = dispersion["cv"]
        eprint(
            f"[ARES_SLEEVE_PRIMARY] active={dispersion['active_count']} input_cv={input_cv} "
            f"output_cv={output_cv} target_gross={dispersion['gross']} unique={dispersion['unique_weight_count_6dp']}"
        )
        eprint(
            f"[ARES_DISPERSION_GUARD_PASS] cv={output_cv} unique={dispersion['unique_weight_count_6dp']} "
            f"gross={dispersion['gross']} candidate={payload['champion_candidate_id']}"
        )

        if cfg.output_json:
            write_output_file(cfg.output_json, payload)
        if cfg.publish_redis:
            if client is None:
                client = connect_redis(cfg.redis_url)
            publish_payload(client, cfg, payload)

        return EngineResult(ok=True, payload=payload)

    except FailClosed as exc:
        reason = str(exc)
        payload = build_fail_payload(cfg, reason, ts)
        eprint(f"[ARES_DISPERSION_GUARD_FAIL_CLOSED] reason={reason}")
        if cfg.output_json:
            write_output_file(cfg.output_json, payload)
        if cfg.publish_redis:
            if client is None:
                client = connect_redis(cfg.redis_url)
            publish_payload(client, cfg, payload)
        return EngineResult(ok=False, payload=payload, reason=reason)

    except Exception as exc:
        reason = f"runtime_error:{type(exc).__name__}:{exc}"
        payload = build_fail_payload(cfg, reason, ts)
        eprint(f"[RAM26_ENGINE_RUNTIME_FAIL_CLOSED] {reason}")
        if cfg.output_json:
            write_output_file(cfg.output_json, payload)
        if cfg.publish_redis:
            try:
                if client is None:
                    client = connect_redis(cfg.redis_url)
                publish_payload(client, cfg, payload)
            except Exception as publish_exc:
                eprint(f"[RAM26_FAIL_PUBLISH_WARN] {type(publish_exc).__name__}: {publish_exc}")
        return EngineResult(ok=False, payload=payload, reason=reason)


