  guardian-self-audit:
    exec: /home/ubuntu/ares_current/registry_self_audit.py
    interpreter: python3
    cwd: /home/ubuntu/ares_current
    enabled: true
    critical: false
    notes: 'Musk-refactor: self-verifying audit loop (5min). Writes Redis guardian:audit:*.'
  ares-sleeve-freshness-watcher:
    domain: ops
    description: Watches sleeve:ares:weights freshness and Bridge LAMBDA_APPLY_SKIP;
      auto-restarts writer on stall.
    script_path: /home/ubuntu/ares_sleeve_freshness_watcher.py
    runner: pm2
    tier: high
    owner: manus-ai
  ares-pm2-drift-detector:
    domain: ops
    description: Detects pm2 script-path drift vs /etc/ares/pm2_allowlist.json
    script_path: /home/ubuntu/ares_pm2_drift_detector.py
    runner: pm2
    tier: medium
    owner: manus-ai
_meta:
  version: '2.0'
  last_updated: '2026-04-14T15:23:43Z'
