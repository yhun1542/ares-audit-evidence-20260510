    exec: /home/ubuntu/ares_current/technical_indicator_writer_v2.py
    interpreter: python3
    cwd: /home/ubuntu/ares_current
    critical: true
    invariant_tags:
    - ta_writer
    description: "\uAE30\uC220\uC9C0\uD45C \uACC4\uC0B0 \uBC0F Redis \uAE30\uB85D\
      \ (RSI, BB, \uBCC0\uB3D9\uC131, 52\uC8FC \uBC94\uC704)"
