    data_contract:
      writes:
      - indicator:{SYM}:*
      - vol:{SYM}:*
      - price:{SYM}:Nd
      - price:{SYM}:high_52w
      reads:
      - price:{SYM}
      - champion:universe:global
  universe-sync-daemon:
    exec: /home/ubuntu/universe_sync_daemon.py
    interpreter: python3
    cwd: /home/ubuntu
    critical: true
    invariant_tags:
    - universe_sync
    description: "\uC720\uB2C8\uBC84\uC2A4 \uD0A4 \uB3D9\uAE30\uD654 \uB370\uBAAC\
      \ (champion:universe:global \uAC31\uC2E0)"
