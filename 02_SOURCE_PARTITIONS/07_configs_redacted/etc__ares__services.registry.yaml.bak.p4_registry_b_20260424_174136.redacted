  realtime-data-feed-v3:
    exec: /home/ubuntu/aub-trading-system/realtime-data-feed-v3.mjs
    interpreter: node
    cwd: /home/ubuntu/ares_current
    critical: true
    invariant_tags:
    - data_feed
