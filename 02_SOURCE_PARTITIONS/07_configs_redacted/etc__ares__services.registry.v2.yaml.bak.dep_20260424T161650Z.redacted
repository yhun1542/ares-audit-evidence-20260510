  redis-env-sentinel:
    runtime: node22
    entry: /home/ubuntu/ares_fix/redis_env_sentinel.mjs
    cwd: /home/ubuntu/ares_fix
    runner: pm2
    tier: tier-1
    singleton: true
    critical: true
    env_file: /home/ubuntu/.env
    env:
      PM2_SENTINEL_AUTOFIX: '1'
      PM2_SENTINEL_INTERVAL_MS: '60000'
    restart_policy:
      autorestart: true
      max_restarts: 10
      min_uptime: 30s
      restart_delay_ms: 5000
      exp_backoff: true
      max_memory_restart: 256M
    heartbeat:
      key: ares:redis-env-sentinel:heartbeat
      domain: infra
      interval_sec: 30
      ttl_sec: 120
      staleness_alert_sec: 90
      library_integration: sidecar
    invariant_tags:
    - redis-env-consistency
    - pm2-env-sanity
    data_contract:
      reads:
      - pm2:process:*:env
      writes:
      - ares:redis-env-sentinel:heartbeat
      - ares:redis_env_sentinel:report
    owner: ops
    notes: Scans every PM2 app's env every 60s. If any app has REDIS_URL pointing
      to localhost (SSOT violation) and AUTOFIX=1, it restarts the app with the correct
      env. Added 2026-04-23.
