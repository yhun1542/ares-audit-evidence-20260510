# /etc/ares/options-trader.env
# Copy this file to /etc/ares/options-trader.env on EC2 and edit per-host.
# chmod 600 /etc/ares/options-trader.env

# Mode: live | paper | dry-run
OPT_TRADER_MODE=dry-run

OPT_TRADER_BIND=127.0.0.1
OPT_TRADER_PORT=7082
OPT_TRADER_LOG_LEVEL=info

# Broker (v7.7) — ARES_BROKER_TOKEN reused from /etc/ares/broker.env
KIS_BROKER_URL=http://127.0.0.1:7071
KIS_BROKER_TIMEOUT_MS=15000

# Redis
REDIS_URL=rediss://***REDACTED***@master.ares-redis-ha.hgv1iy.apn2.cache.amazonaws.com:6379
OPT_INTENT_STREAM=ares:options:intent
OPT_INTENT_GROUP=ares-options-trader
OPT_FILL_STREAM=ares:options:fills
OPT_AUDIT_STREAM=ares:audit:options-trader

# Risk limits (tuned for scaffold phase — raise after verification)
OPT_MAX_CONTRACTS_PER_ORDER=10
OPT_MAX_ORDERS_PER_MINUTE=5
OPT_MAX_ORDERS_PER_DAY=100
OPT_MAX_NOTIONAL_PER_ORDER_USD=10000
OPT_MAX_DAILY_LOSS_USD=5000

# Killswitch
OPT_KILLSWITCH_FILE=/etc/ares/options_killswitch
OPT_KILLSWITCH_CHECK_MS=2000
