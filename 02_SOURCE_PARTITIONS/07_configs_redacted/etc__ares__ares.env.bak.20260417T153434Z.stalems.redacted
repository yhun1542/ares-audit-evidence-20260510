# App identity
APP_NAME=ares
APP_ENV=production
CANONICAL_ROOT=/home/ubuntu/ares_current
CANONICAL_SHARED=/etc/ares
CANONICAL_LOG_DIR=/var/log/ares
CANONICAL_RUN_DIR=/var/run/ares

# Redis — TLS only, never localhost
REDIS_URL=rediss://***REDACTED***@master.ares-redis-ha.hgv1iy.apn2.cache.amazonaws.com:6379
REDIS_PASSWORD=***REDACTED***
REDISCLI_AUTH=Q5L7MzWVBt1hjFKlUTmCXqlssss5-fwT36Nz1L1P10U
ARES_REDIS_HOST=master.ares-redis-ha.hgv1iy.apn2.cache.amazonaws.com
ARES_REDIS_PORT=6379
ARES_REDIS_PASSWORD=***REDACTED***
ARES_REDIS_SSL=true
ARES_REDIS_DB=0
ALLOW_LOCALHOST_REDIS=false
REQUIRE_REDIS_TLS=true

# Trading safety
