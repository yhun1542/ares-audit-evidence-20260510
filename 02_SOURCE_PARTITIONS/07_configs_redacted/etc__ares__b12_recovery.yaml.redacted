# ============================================================================
# B12 Auto-Recovery Sentinel — 설정 템플릿 (v1.0.0)
#
# 중요 안전 기본값:
#   observe_only: true                  # 관측 기간 중에는 반드시 유지
#   auto_restart_sidecars: false        # 관측 종료 후에도 신중히 활성화
#   f22_protected_names: 엄수           # 4개 파일은 절대 pm2 조작 대상 아님
# ============================================================================

redis:
  url: ""
  host: "127.0.0.1"
  port: 6379
  db: 0
  use_tls: false
  password_env: "ARES_REDIS_PASSWORD"

poll_interval_sec: 15
heartbeat_interval_sec: 30

pm2_binary: "/usr/bin/pm2"
pm2_jlist_timeout_sec: 3.0

# Flapping 임계값
flapping_1m_threshold: 3
flapping_5m_threshold: 5

# STUCK 판정: 로그 파일 mtime 이 이 시간 이상 갱신 없음
stuck_log_silence_sec: 600

# 메모리 누수 탐지
leak_window_min: 30
leak_ratio_threshold: 2.0

# Circuit breaker
breaker_window_sec: 3600
breaker_max_restarts: 2
global_breaker_window_sec: 300
global_breaker_max_restarts: 3
breaker_ttl_sec: 3600

# F22 보호 리스트. userMemory 고정값.
f22_protected_names:
  - "nextgen2-live"
  - "final-to-champion-bridge"
  - "live-trading-kis"
  - "ares-v56-live"

# 관측 대상 사이드카 heartbeat
heartbeat_targets:
  - name: "b02"
    key: "addon:b02:heartbeat"
    max_age_sec: 120
  - name: "b05"
    key: "addon:b05:heartbeat"
    max_age_sec: 120
  - name: "b09"
    key: "addon:b09:heartbeat"
    max_age_sec: 120

action_log_path: "/var/log/ares/b12_actions.log"
log_level: "INFO"

# 필수 유지: true. 관측 종료 후에도 아주 신중히 false 로 전환.
observe_only: true

# 필수 유지: false. 관측 종료 + 최소 30일 observe-only 관찰 후에만 true 고려.
auto_restart_sidecars: false
