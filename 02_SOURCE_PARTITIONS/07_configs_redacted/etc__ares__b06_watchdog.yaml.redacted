# ============================================================================
# B06 Redis Watchdog — 설정 템플릿 (v1.0.0)
#
# 중요: auto_restart 는 기본 false. 관측 기간(~5/3) 중에는 절대 true 금지.
# ============================================================================

redis:
  url: ""
  host: "127.0.0.1"
  port: 6379
  db: 0
  use_tls: false
  password_env: "ARES_REDIS_PASSWORD"
  socket_timeout_sec: 2.0
  socket_connect_timeout_sec: 2.0

ping_interval_sec: 3.0
fail_threshold: 3            # 3회 연속 실패 시 down 이벤트

# 필수 유지: false. 자동 재시작은 별도 승인 후에만.
auto_restart: false

# 자동 재시작이 허용될 때 실행할 명령. sudoers 설정 필요.
# 예: ubuntu ALL=(ALL) NOPASSWD: /bin/systemctl restart redis-server
restart_cmd:
  - "sudo"
  - "systemctl"
  - "restart"
  - "redis-server"

# 재시작 쿨다운 (초). 이 시간 내 재시도 금지.
restart_cooldown_sec: 3600

local_state_file: "/tmp/b06_watchdog_state.json"
log_level: "INFO"
