schema_version: 2026-05-06.health-watchdog.v1
defaults:
  max_staleness_s: 90
  max_pm2_restart_in_5m: 3
  severity: P0
guards:
  rt-position-guard-v9:
    health_keys:
    - ctx:rt_guard:health
    max_staleness_s: 90
    parse_format: json_ms:ts
    severity: P0
  exposure-monitor:
    severity: P0
  trade-actuator-supervisor:
    health_keys:
    - trade-actuator-supervisor:heartbeat
    max_staleness_s: 60
    parse_format: ms_ts
    severity: P0
  kill-switch-authority:
    health_keys:
    - kill-switch-authority:heartbeat
    max_staleness_s: 60
    parse_format: ms_ts
    severity: P0
  ares-upstream-ssot-router:
    health_keys:
    - ares-upstream-ssot-router:health
    max_staleness_s: 180
    parse_format: json:ts
    severity: P0
  ssot-pipeline-guard:
    severity: P0
    health_keys:
    - ssot:guard:v4:heartbeat
    parse_format: ms_ts
    max_staleness_s: 90
  realtime-data-feed-v3:
    max_pm2_restart_in_5m: 5
    severity: P0
    health_keys:
    - realtime:feed:health
    parse_format: json:ts
    max_staleness_s: 180
  kis-balance-sync:
    severity: P0
    health_keys:
    - kis:balance-sync:heartbeat
    parse_format: ts
    max_staleness_s: 240
  kis-token-service:
    severity: P0
    health_keys:
    - kis:token:health
    parse_format: json_ms:ts
    max_staleness_s: 180
  ssot-writer-v2:
    severity: P0
    health_keys:
    - ssot:writer:v2:health
    parse_format: json_ms:ts
    max_staleness_s: 600
  xgb-riskflag-writer-v5:
    severity: P1
  multi-source-regime-detector:
    severity: P0
    health_keys:
    - ctx:multi-source-regime-detector:health
    parse_format: json_ms:ts
    max_staleness_s: 240
  technical-indicator-writer-v2:
    severity: P0
    health_keys:
    - ctx:technical-indicator-writer-v2:health
    parse_format: json_ms:ts
    max_staleness_s: 1500
  final-trade-gate:
    severity: P0
    health_keys:
    - ares:final_trade_gate:heartbeat
    - ftg:heartbeat
    parse_format: ms_ts
    max_staleness_s: 90
  go-nogo-judge-v2:
    severity: P0
  structural-integrity-guard:
    severity: P0
  ares-final-trade-gate-v50-active:
    severity: P0
  ares-final-trade-gate-v50-shadow:
    severity: P1
