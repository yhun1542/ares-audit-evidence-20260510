# ARES B-Series v2.5.1 live-go hotfix — canonical F22 protection list
# Single source of truth for deployment tooling and runbooks.
version: "2.5.1"

# Must be online before any B-Series sidecar deployment proceeds.
required_online:
  - "nextgen2-live"
  - "final-to-champion-bridge"
  - "live-trading-kis"

# At least one may exist depending on the EC2 generation / historical naming.
optional_online_any_of:
  - "gpu-crash-sentinel-live"
  - "ares-v56-live"

# B-Series tooling must never kill / restart / delete these PM2 names.
protected_pm2_names:
  - "nextgen2-live"
  - "final-to-champion-bridge"
  - "live-trading-kis"
  - "gpu-crash-sentinel-live"
  - "ares-v56-live"

# Legacy / placeholder aliases that may appear in docs, tests, or older environments.
legacy_aliases:
  - "F22-OptionsTrader"
  - "F22-RiskGuard"
  - "F22-PriceCollar"
  - "F22-LatencyMonitor"
