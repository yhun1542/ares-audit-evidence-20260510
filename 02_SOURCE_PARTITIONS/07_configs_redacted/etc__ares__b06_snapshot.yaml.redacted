# ============================================================================
# B06 Redis Snapshot Daemon — 설정 템플릿 (v1.0.0)
# ============================================================================

redis:
  url: ""
  host: "127.0.0.1"
  port: 6379
  db: 0
  use_tls: false
  password_env: "ARES_REDIS_PASSWORD"
  socket_timeout_sec: 5.0
  socket_connect_timeout_sec: 5.0

# 스냅샷 주기 (초). 15분 권장.
interval_sec: 900

# SCAN 대상 화이트리스트. 이 외 패턴은 절대 덤프되지 않음.
include_patterns:
  - "LIVE_UNI_*"
  - "ares:dtch:*"
  - "emarkos:*"
  - "addon:b0*"
  # 필요 시 추가 프리픽스.

# 명시적으로 제외할 패턴 (예: 대용량 임시 데이터).
exclude_patterns: []

max_scan_per_pattern: 20000       # 패턴당 최대 스캔 키 수 (안전장치)
max_value_bytes: 5000000          # 5MB 초과 키는 skip
scan_count: 500
heartbeat_interval_sec: 60

# 로컬 저장 디렉토리 (업로드 성공 시 자동 제거)
local_dir: "/tmp/b06_snapshots"

# S3 (비어 있으면 로컬만 저장)
s3_bucket: ""                      # 예: "ares-redis-snapshots"
s3_prefix: "ares/redis-snapshots/"
aws_region: ""                     # 비어 있으면 boto3 기본

# Circuit breaker
max_consecutive_failures: 3
circuit_reset_sec: 3600
keep_local_on_failure_sec: 86400

log_level: "INFO"
