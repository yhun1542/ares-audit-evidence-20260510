# ============================================================================
# B07 Canary Deployment Pipeline — 설정 템플릿 (v1.0.0)
#
# 중요: F22 엔진 4개 파일에 대해서는 본 파이프라인 자체가 거부한다.
#       F22 배포는 별도 12-gate framework + walk-forward 6/6 절차로만.
# ============================================================================

redis:
  url: ""
  host: "127.0.0.1"
  port: 6379
  db: 0
  use_tls: false
  password_env: "ARES_REDIS_PASSWORD"

# Canary 가 사용할 Redis db. 반드시 live db 와 분리된 숫자.
canary_paper_db: 10

# Canary 실행 기간 (기본 24h).
canary_duration_sec: 86400

# 필수 유지: true. 자동 승격은 감사 원칙 위반.
# 명시적으로 false 로 바꾸려면 운영팀 승인 + 감사 로그 필수.
manual_approval_required: true

pm2_binary: "/usr/bin/pm2"
pm2_ecosystem_template: ""

# Metric gate 기준
gate:
  max_pm2_restarts: 0
  max_redis_errors: 0
  pnl_sigma_multiplier: 1.0       # baseline ±1σ 내만 허용
  max_error_rate_ratio: 1.5       # canary / baseline 에러율 비율
  min_runtime_sec: 3600           # 최소 1h 운영
  min_n_samples: 30

slack_webhook_env: "ARES_SLACK_WEBHOOK"

# 결정 감사 로그 (append-only)
audit_log_path: "/var/log/ares/b07_decisions.log"

# Redis 결정 히스토리 리스트 최대 길이
history_max: 100

log_level: "INFO"
