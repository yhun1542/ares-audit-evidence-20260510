/* P11-CONSOLIDATED */ // [STRUCTURAL-FIX v2.0] Load Redis config from SSOT file, then credentials
// IMPORTANT: This file MUST be named ecosystem.config.cjs (or symlinked) for PM2 to recognize it as config.
//            PM2 6.x only recognizes ecosystem.config.{js,cjs,mjs} as config files.
//            If started with a different filename, PM2 will execute it as a Node.js script instead.
// SAFE STARTUP: Use /home/ubuntu/pm2_safe_startup.sh for production startup.
const fs = require("fs");
function loadEnvFile(filePath) {
  try {
    const content = fs.readFileSync(filePath, "utf8");
    for (const line of content.split("\n")) {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith("#")) continue;
      const eqIdx = trimmed.indexOf("=");
      if (eqIdx === -1) continue;
      const key = trimmed.slice(0, eqIdx).trim();
      let val = trimmed.slice(eqIdx + 1).trim();
      // [ARES_PATCH_E2_20260508] strip surrounding single/double quotes from env values to avoid REDIS_URL='...'/0 corruption
      if (val.length >= 2) {
        const first = val.charAt(0);
        const last = val.charAt(val.length - 1);
        if ((first === "'" && last === "'") || (first === '"' && last === '"')) {
          val = val.slice(1, -1);
        }
      }
      process.env[key] = val;  // [SSOT] 강제 덮어쓰기 — PM2 dump/God daemon env 무력화
    }
  } catch (e) {
    console.error("[STRUCTURAL-FIX] FATAL: Cannot read " + filePath + ": " + e.message);
  }
}
loadEnvFile("/etc/ares/redis.env");  // [SSOT] Redis config — 이 파일이 유일한 출처
loadEnvFile("/etc/ares/kis_production.env");  // [SSOT] KIS credentials — auto-synced from AWS Secrets Manager (ares/production/kis)
try { require("dotenv").config({ path: "/home/ubuntu/.env.credentials", override: false }); } catch(e) {}

// --- [4-AI CONSENSUS: EXPLICIT SSOT INJECTION] ---
const crypto = require('node:crypto');
const { parseEnv } = require('node:util');

function readEnvFile(file) {
  try {
    return parseEnv(fs.readFileSync(file, 'utf8'));
  } catch (e) {
    console.error("[STRUCTURAL-FIX] FATAL: Cannot read " + file + ": " + e.message);
    return {};
  }
}

function sha8(v) {
  return crypto.createHash('sha256').update(v).digest('hex').slice(0, 8);
}

function must(obj, key, label) {
  if (!obj[key]) throw new Error(`${label}: missing ${key}`);
  return obj[key];
}

const kisFile = readEnvFile('/etc/ares/kis_production.env');
const aresFile = readEnvFile('/etc/ares/ares.env');

const inherited = { ...process.env };
for (const k of Object.keys(inherited)) {
  if (k === 'REDIS_PASSWORD' || k.startsWith('KIS_')) {
    delete inherited[k];
  }
}

const KIS_APP_KEY = must(kisFile, 'KIS_APP_KEY', 'kis_production.env');
const REDIS_PASSWORD_SSOT = must(aresFile, 'REDIS_PASSWORD', 'ares.env');

if (sha8(KIS_APP_KEY) !== '43e0b209') {
  throw new Error(`KIS_APP_KEY hash mismatch: ${sha8(KIS_APP_KEY)}`);
}
if (sha8(REDIS_PASSWORD_SSOT) !== '10d6bd21') {
  throw new Error(`REDIS_PASSWORD hash mismatch: ${sha8(REDIS_PASSWORD_SSOT)}`);
}

const kisRuntimeEnv = {
  ...inherited,
  NODE_ENV: 'production',
  KIS_APP_KEY,
  KIS_APP_SECRET: must(kisFile, 'KIS_APP_SECRET', 'kis_production.env'),
  KIS_HTS_ID: must(kisFile, 'KIS_HTS_ID', 'kis_production.env'),
  REDIS_PASSWORD: REDIS_PASSWORD_SSOT,
  KIS_LIVE_APPKEY_SHA256: aresFile.KIS_LIVE_APPKEY_SHA256 || kisFile.KIS_LIVE_APPKEY_SHA256 || '43e0b209b95b745fd88854971f5598221878f32affa5c189fe4fd96082b091a7',
};
