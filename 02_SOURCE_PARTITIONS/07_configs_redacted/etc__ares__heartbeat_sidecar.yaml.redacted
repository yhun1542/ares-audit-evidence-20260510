guards:
  ssot-pipeline-guard:
    legacy_keys:
    - ssot:guard:v4:heartbeat
    legacy_max_age_s: 240
    log_path: /home/ubuntu/.pm2/logs/ssot-pipeline-guard-out.log
    log_pattern: 'ssot-guard:'
    log_max_age_s: 180
    ttl_s: 300
  realtime-data-feed-v3:
    legacy_keys:
    - realtime:feed:health
    legacy_max_age_s: 180
    log_path: /home/ubuntu/.pm2/logs/realtime-data-feed-v3-out.log
    log_pattern: '"status":"healthy"'
    log_max_age_s: 180
    ttl_s: 300
  kis-balance-sync:
    legacy_keys:
    - kis:balance-sync:heartbeat
    - ares:health:kis-balance-sync:heartbeat
    legacy_max_age_s: 240
    log_path: /home/ubuntu/.pm2/logs/kis-balance-sync-out.log
    log_pattern: Balance Sync Cycle Start
    log_max_age_s: 120
    ttl_s: 300
  kis-token-service:
    legacy_keys:
    - kis:token:health
    legacy_max_age_s: 240
    log_path: /home/ubuntu/.pm2/logs/kis-token-service-out.log
    log_pattern: kis.token.health
    log_max_age_s: 240
    ttl_s: 300
  ssot-writer-v2:
    legacy_keys:
    - ssot:writer:v2:health
    legacy_max_age_s: 600
    log_path: /home/ubuntu/.pm2/logs/ssot-writer-v2-out.log
    log_pattern: '"engine_version"'
    log_max_age_s: 600
    ttl_s: 900
  multi-source-regime-detector:
    legacy_keys:
    - ctx:multi-source-regime-detector:health
    legacy_max_age_s: 240
    log_path: /home/ubuntu/.pm2/logs/multi-source-regime-detector-out.log
    log_pattern: regime
    log_max_age_s: 240
    ttl_s: 300
  technical-indicator-writer-v2:
    legacy_keys:
    - ctx:technical-indicator-writer-v2:health
    legacy_max_age_s: 1500
    log_path: /home/ubuntu/.pm2/logs/technical-indicator-writer-v2-out.log
    log_pattern: indicator
    log_max_age_s: 1500
    ttl_s: 1800
  final-trade-gate:
    legacy_keys:
    - ares:final_trade_gate:heartbeat
    - ftg:heartbeat
    legacy_max_age_s: 120
    log_path: /home/ubuntu/.pm2/logs/final-trade-gate-out.log
    log_pattern: final_trade_gate
    log_max_age_s: 120
    ttl_s: 240
  execution-reconciler:
    legacy_keys: []
    legacy_max_age_s: 600
    log_path: /home/ubuntu/.pm2/logs/execution-reconciler-out.log
    log_pattern: reconcil
    log_max_age_s: 1800
    ttl_s: 2400
  final-to-champion-bridge:
    legacy_keys: []
    legacy_max_age_s: 120
    log_path: /home/ubuntu/.pm2/logs/final-to-champion-bridge-out.log
    log_pattern: '[SSOT_TARGETS]'
    log_max_age_s: 180
    ttl_s: 300
  nextgen2-live:
    legacy_keys: []
    legacy_max_age_s: 600
    log_path: /home/ubuntu/.pm2/logs/nextgen2-live-error.log
    log_pattern: INFO
    log_max_age_s: 1800
    ttl_s: 2400
  order-intent-executor:
    legacy_keys: []
    legacy_max_age_s: 600
    log_path: /home/ubuntu/.pm2/logs/order-intent-executor-error.log
    log_pattern: INFO
    log_max_age_s: 14400
    ttl_s: 18000
  position-sync-service:
    legacy_keys: []
    legacy_max_age_s: 120
    log_path: /home/ubuntu/.pm2/logs/position-sync-service-out.log
    log_pattern: '"event":"sync'
    log_max_age_s: 180
    ttl_s: 300
  regime-writer-v88:
    legacy_keys: []
    legacy_max_age_s: 300
    log_path: /home/ubuntu/.pm2/logs/regime-writer-v88-out.log
    log_pattern: regime
    log_max_age_s: 600
    ttl_s: 900
  rt-position-guard-v9:
    legacy_keys:
    - ctx:rt_guard:health
    legacy_max_age_s: 240
    log_path: /home/ubuntu/.pm2/logs/rt-position-guard-v9-out.log
    log_pattern: '[INFO]'
    log_max_age_s: 3600
    ttl_s: 4800
  ssot-promote-v2:
    legacy_keys:
    - ssot:promote:v2:health
    legacy_max_age_s: 240
    log_path: /home/ubuntu/.pm2/logs/ssot-promote-v2-out.log
    log_pattern: '[POLICY_UNIVERSE_FILTER]'
    log_max_age_s: 300
    ttl_s: 600
  go-nogo-judge-v2:
    legacy_keys: []
    legacy_max_age_s: 120
    log_path: /home/ubuntu/.pm2/logs/go-nogo-judge-v2-out.log
    log_pattern: 'INFO'
    log_max_age_s: 43200
    ttl_s: 180
  kill-switch-authority:
    legacy_keys:
    - kill-switch-authority:heartbeat
    legacy_max_age_s: 90
    log_path: /home/ubuntu/.pm2/logs/kill-switch-authority-out.log
    log_pattern: 'poll\|trading:enabled\|starting'
    log_max_age_s: 90
    ttl_s: 120
