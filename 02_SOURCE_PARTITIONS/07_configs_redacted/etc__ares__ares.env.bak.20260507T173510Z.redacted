# ============================================================
# NET_MAX Fix — Long-Only portfolio NET exposure limit (2026-04-17)
# Previous default: 0.30 (L/S assumption) -> permanent RISK_OFF
# New value: 1.05 (Long-Only compatible, allows NET up to 1.05)
# ============================================================
NET_MAX=1.05

# [v8.4 patch 2026-04-17] Fix CONSERVATIVE_FALLBACK race: detector interval 5min vs STALE_MS default 5min
STALE_MS=480000

# ============================================================
# [STRUCTURAL FIX 2026-04-21] Invariant HIGH AUTO-HALT exclusions
# ------------------------------------------------------------
# Prev state: Two conflicting lines (INV-EQ-002 / INV-ORD-001) caused
#             invariant-checker to keep only one, and leftover runtime
#             kept auto-HALTing via trade:halt, driving FTG flapping.
# Fix:        Single canonical value with both invariants merged.
#             INV-EQ-002 and INV-ORD-001 are confirmed false-positive
#             during off-hours / light-activity windows and must be
#             alert-only. CRITICAL invariants remain auto-halt.
# ============================================================
INV_HIGH_AUTOHALT_EXCLUDE="INV-EQ-002,INV-ORD-001"

# [STRUCTURAL FIX 2026-04-21] HIGH consecutive threshold raised
# Reason: default 3 -> triggers on 90s window, too sensitive for
# off-hours false-positives. 10 -> 5min window, still fast enough.
HIGH_CONSECUTIVE_THRESHOLD=10


