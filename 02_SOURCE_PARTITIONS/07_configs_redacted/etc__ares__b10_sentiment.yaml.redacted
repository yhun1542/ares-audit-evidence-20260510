# ============================================================================
# B10 LLM News Sentiment — 설정 템플릿 (v1.0.0)
# ============================================================================

redis:
  url: ""
  host: "127.0.0.1"
  port: 6379
  db: 0
  use_tls: false
  password_env: "ARES_REDIS_PASSWORD"

# Provider 선택
#   rule_based : 외부 API 불필요 (기본, 권장 초기값)
#   openai     : OPENAI_API_KEY + `openai` SDK 필요
#   anthropic  : ANTHROPIC_API_KEY + `anthropic` SDK 필요
# LLM provider 실패 시 자동으로 rule_based 로 fallback.
provider: "rule_based"

# 시간당 토큰 예산 (hard cap). 초과 시 rule_based 로 전환.
hourly_token_budget: 200000

# 한 사이클에 처리할 최대 기사 수
max_articles_per_cycle: 50

# 집계 윈도우 (이 안의 기사만 반영). 1시간 기본.
aggregation_window_sec: 3600

# 각종 TTL
sentiment_ttl_sec: 86400
url_cache_ttl_sec: 86400

# Redis Stream 관련 (XREAD)
stream_block_ms: 2000
stream_consumer_group: "b10"
stream_consumer_name: "b10-worker-1"

poll_interval_sec: 30
heartbeat_interval_sec: 30

log_level: "INFO"

# 관측 전용. 기본 true 유지 — F22 는 본 결과를 자동 참조하지 않음.
observe_only: true
