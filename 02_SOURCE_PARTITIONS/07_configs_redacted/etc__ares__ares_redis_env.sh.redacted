#!/usr/bin/env bash
# ARES Redis SSOT loader. Source this file; it prints no secrets.
_ares_loader_xtrace_was_on=0
case "$-" in *x*) _ares_loader_xtrace_was_on=1; set +x ;; esac
if [[ -r /etc/ares/redis.env ]]; then
  set -a
  # shellcheck source=/dev/null
  . /etc/ares/redis.env
  set +a
fi
if [[ $_ares_loader_xtrace_was_on -eq 1 ]]; then set -x; fi
if [[ -z "${REDIS_URL:-}" && -z "${ARES_REDIS_HOST:-}" ]]; then
  echo "[ARES_REDIS_SSOT_FATAL] REDIS_URL or ARES_REDIS_HOST is required" >&2
  return 64 2>/dev/null || exit 64
fi
export ARES_REDIS_SSOT_LOADED=1
