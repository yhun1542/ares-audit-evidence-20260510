# /etc/ares/ai-review.env  -- chmod 0600 ubuntu:ubuntu
# 4-AI 주간 자동 리뷰 시스템 환경변수
# Created: 2026-04-20 / ARES-KIS-US v7.2 reviewer kit

# === Grok (xAI) ===
XAI_API_KEY=***REDACTED***
GROK_MODEL="grok-4.20-multi-agent-beta-0309"
GROK_ENDPOINT="https://api.x.ai/v1/responses"

# === Claude (Anthropic) ===
ANTHROPIC_API_KEY=***REDACTED***
CLAUDE_MODEL="claude-opus-4-6"
CLAUDE_ENDPOINT="https://api.anthropic.com/v1/messages"
CLAUDE_VERSION="2023-06-01"

# === GPT-5.4-pro (OpenAI) ===
OPENAI_API_KEY=***REDACTED***
GPT_MODEL="gpt-5.4-pro"
GPT_ENDPOINT="https://api.openai.com/v1/responses"

# === Gemini 2.5 Flash (Google AI) ===
GEMINI_API_KEY=***REDACTED***
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_ENDPOINT="https://generativelanguage.googleapis.com/v1beta/models"

# === Reviewer 공통 설정 ===
AI_REVIEW_ROOT="/home/ubuntu/ai-reviews"
AI_REVIEW_BUNDLE="/home/ubuntu/ai-reviews/bundle"
AI_REVIEW_LOG_RETENTION_DAYS=180

# 추론 토큰은 항상 최대치 (각 모듈 내부에서 강제):
#   - Grok: max_output_tokens=32768
#   - Claude: max_tokens=32000, thinking budget=24000 (extended thinking)
#   - GPT-5.4-pro: max_output_tokens=32768, reasoning.effort="high"
#   - Gemini-2.5-flash: maxOutputTokens=65535, thinkingConfig.thinkingBudget=-1 (dynamic max)
