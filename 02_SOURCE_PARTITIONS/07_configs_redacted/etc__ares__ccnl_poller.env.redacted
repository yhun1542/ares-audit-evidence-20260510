# /etc/ares/ccnl_poller.env  (chmod 600, owned by ubuntu)
# ------------------------------------------------------------------
# kis_ccnl_truth_poller_v1 environment template
# Copy this file to /etc/ares/ccnl_poller.env and fill in real values.
# Lines beginning with `#` are comments. The deploy.sh script source-loads
# /etc/ares/redis.env, /etc/ares/kis.env, and (optionally) this file.
# ------------------------------------------------------------------

# Redis connection — required.
# REDIS_URL must already be exported via /etc/ares/redis.env. Do NOT duplicate here.
# REDIS_URL=rediss://***REDACTED***@master.ares-redis-ha.<region>.cache.amazonaws.com:6379

# KIS open-API — required (must be exported via /etc/ares/kis.env).
# KIS_API_BASE=https://openapi.koreainvestment.com:9443
# KIS_ACCOUNT_NO=8123XXXX
# KIS_ACCOUNT_PRODUCT_CD=01
# KIS_APP_KEY=***REDACTED***
# KIS_APP_SECRET=***REDACTED***

# --- Poller knobs (override defaults if needed) ---
CCNL_SHADOW_ONLY=true              # Initial deploy: keep TRUE for ≥1 US session
CCNL_POLL_INTERVAL_MS=5000         # 5s during US session
CCNL_IDLE_INTERVAL_MS=60000        # 60s outside US session
CCNL_LOOKBACK_DAYS=1               # 1 day lookback covers session rollover
CCNL_MAX_PAGES=20                  # Safety cap per tick
CCNL_HTTP_TIMEOUT_MS=15000         # 15s per HTTP call

# --- Output streams ---
FILLS_CANONICAL_STREAM=ares:fills:canonical
FILLS_CANONICAL_MIRRORS=emarkos:v6:stream:fills
FILLS_STREAM_MAXLEN=50000

# --- Process owner ---
NODE_ENV=production
TZ=Asia/Seoul
