      autorestart: true
      max_restarts: 10
      min_uptime: 30s
      restart_delay_ms: 3000
      exp_backoff: true
      max_memory_restart: 256M
    heartbeat:
      key: ares:halt_bridge:heartbeat
      domain: ops
      interval_sec: 30
      ttl_sec: 90
      staleness_alert_sec: 60
      library_integration: native
    invariant_tags:
    - halt-consistency
    - trade-halt-ssot
    data_contract:
      reads:
      - trade:halt
      - trade:halt:reason
      - trade:halt:ts
      - ares:halt:active
      - ares:halt:severity
      - trading:enabled
      writes:
      - trade:halt
      - trade:halt:ts
      - ares:halt:active
      - ares:halt_bridge:heartbeat
    owner: ops
    notes: 'Structural halt consistency daemon. SSOT for halt: ares:halt:active; mirrors to legacy trade:halt with TTL. Added 2026-04-23.'
