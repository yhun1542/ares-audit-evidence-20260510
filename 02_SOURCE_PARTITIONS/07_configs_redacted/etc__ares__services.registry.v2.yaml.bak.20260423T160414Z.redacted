version: '2.1'
defaults:
  env_file: /etc/ares/ares.env
  runner: pm2
  restart_policy:
    autorestart: true
    max_restarts: 10
    min_uptime: 30s
    restart_delay_ms: 3000
    exp_backoff: true
    max_memory_restart: 1G
services:
  pm2-logrotate:
    runtime: node22
    entry: /home/ubuntu/.pm2/modules/pm2-logrotate/node_modules/pm2-logrotate/app.js
    cwd: /home/ubuntu/.pm2/modules/pm2-logrotate/node_modules/pm2-logrotate
    tier: tier-2
    heartbeat:
      key: ares:pm2-logrotate:heartbeat
      domain: ares
      interval_sec: 10
      ttl_sec: 60
      staleness_alert_sec: 45
      library_integration: sidecar
  multi-source-regime-detector:
    runtime: node22
    entry: /home/ubuntu/ares_current/external/multi-source-regime-detector.mjs
    cwd: /home/ubuntu
    tier: tier-2
    heartbeat:
      key: ares:multi-source-regime-detector:heartbeat
      domain: ares
      interval_sec: 10
      ttl_sec: 60
      staleness_alert_sec: 45
      library_integration: sidecar
  kis-token-service:
    runtime: node22
    entry: /home/ubuntu/aub-trading-system/kis-token-service.mjs
    cwd: /home/ubuntu/aub-trading-system
    tier: tier-2
    heartbeat:
