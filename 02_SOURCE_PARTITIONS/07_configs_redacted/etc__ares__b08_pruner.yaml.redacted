# ============================================================================
# B08 Engineering Debt Pruner — 설정 템플릿 (v1.0.0)
#
# 본 모듈은 "자동 삭제/정지" 기능이 소스에 존재하지 않는다.
# 오직 리포트만 생성한다. 삭제 결정은 항상 수동.
# ============================================================================

redis:
  url: ""
  host: "127.0.0.1"
  port: 6379
  db: 0
  use_tls: false
  password_env: "ARES_REDIS_PASSWORD"

# 리포트 저장 디렉토리
report_dir: "/var/log/ares"

# S3 백업 (옵션). 비우면 skip.
s3_bucket: ""
s3_prefix: "ares/b08/"

pm2_binary: "/usr/bin/pm2"

# PM2 idle 후보 기준
idle_log_bytes_max: 1024       # 로그 1KB 이하
idle_memory_mb_max: 20         # 메모리 20MB 이하
# (내부 불변식: uptime < 1h 인 프로세스는 평가 유보, F22 이름은 제외)

# Redis 고아 키 스캔
orphan_scan_patterns:
  - "*"                         # 전체 스캔. 단 보호 prefix 는 자동 제외.
orphan_max_scan: 5000
orphan_stale_hours: 24

# 파일시스템 복제본 스캐너
fs_scan_roots:
  - "/home/ubuntu"
fs_exclude_patterns:
  - "/.git/"
  - "/node_modules/"
  - "/__pycache__/"
  - "/venv/"
  - "/.venv/"
  - "/var/"
  - "/tmp/"
  - ".pyc"
  - ".log"

# crontab 파싱. 비우면 `crontab -l` 실행.
crontab_path: ""

log_level: "INFO"
