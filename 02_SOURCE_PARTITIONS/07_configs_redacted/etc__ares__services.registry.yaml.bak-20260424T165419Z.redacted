  rt-position-guard-v9:
    exec: /home/ubuntu/ares_current/external/rt_position_guard_v9.mjs
    interpreter: node
    cwd: /home/ubuntu/ares_current
    critical: true
    invariant_tags:
    - position_guard
    description: 실시간 포지션 가드 v9
    env_required:
    - REDIS_URL
  ares-structural-guardian:
    exec: /home/ubuntu/ares_current/ares_structural_guardian.py
    interpreter: python3
    cwd: /home/ubuntu/ares_current
    critical: true
    invariant_tags:
    - structural_guardian
    description: 구조적 가디언 — 데이터 계약 감시, 자동 복구, 레지스트리 동기화
    env_required:
    - REDIS_URL
    - POLYGON_API_KEY
    - FRED_API_KEY
    - ALPHA_VANTAGE_KEY
    - SEC_API_KEY
    data_contract:
      writes:
      - guardian:health:latest
      - guardian:events
      reads:
      - '*'
  alpha-signal-scheduler:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/alpha_signal_scheduler.py
    interpreter: python3
    env_file: /etc/ares/ares.env
    singleton: true
    critical: false
    invariant_tags:
    - alpha_signal
  realtime-data-feed:
    exec: /home/ubuntu/ares_current/realtime-data-feed.mjs
    interpreter: node
    cwd: /home/ubuntu/ares_current
    enabled: false
    deprecated: true
    critical: false
    superseded_by: realtime-data-feed-v3
    notes: legacy v2; v82 module missing. v3 is the live producer.
  guardian-self-audit:
    exec: /home/ubuntu/ares_current/registry_self_audit.py
    interpreter: python3
    cwd: /home/ubuntu/ares_current
    enabled: true
    critical: false
    notes: 'Musk-refactor: self-verifying audit loop (5min). Writes Redis guardian:audit:*.'
