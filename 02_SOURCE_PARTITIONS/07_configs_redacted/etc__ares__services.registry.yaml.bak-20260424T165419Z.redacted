services:
  nextgen2-live:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/nextgen2/orchestrator.py
    interpreter: python3
    env_file: /etc/ares/ares.env
    singleton: true
    critical: true
    requires:
    - REDIS_URL
    - CANONICAL_ROOT
    invariant_tags:
    - ssot_source
    - regime_producer
    data_contract:
      writes:
      - ssot:target:v2:*
      - regime:*
      reads:
      - xgb:risk:{SYM}:flag
      - regime:current
      - champion:universe:global
  ssot-writer-v2:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/ops/ssot_writer_v2.py
    interpreter: python3
    env_file: /etc/ares/ares.env
    singleton: true
    critical: true
    invariant_tags:
    - ssot_writer
    data_contract:
      writes:
      - ssot:target:v2:*
      reads:
      - regime:current
      - xgb:risk:{SYM}:flag
  ssot-promote-v2:
    cwd: /home/ubuntu/ares_current
