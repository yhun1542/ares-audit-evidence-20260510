    interpreter: node
    env_file: /etc/ares/ares.env
    singleton: true
    critical: true
    invariant_tags:
    - regime_consensus
  ares-ssot-coverage-override:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/external/ares_ssot_coverage_override.py
    enabled: false
    interpreter: python3
    env_file: /etc/ares/ares.env
    singleton: true
    critical: false
    invariant_tags:
    - coverage_override
  realtime-data-feed-v3:
    exec: /home/ubuntu/aub-trading-system/realtime-data-feed-v3.mjs
    interpreter: node
    cwd: /home/ubuntu/ares_current
    critical: true
    invariant_tags:
    - data_feed
    description: 실시간 시장 데이터 수집 (Polygon WebSocket)
    env_required:
    - POLYGON_API_KEY
    - REDIS_URL
    data_contract:
      writes:
      - price:{SYM}
      reads:
      - champion:universe:global
  technical-indicator-writer-v2:
    exec: /home/ubuntu/ares_current/technical_indicator_writer_v2.py
    interpreter: python3
    cwd: /home/ubuntu/ares_current
    critical: true
    invariant_tags:
    - ta_writer
    description: 기술지표 계산 및 Redis 기록 (RSI, BB, 변동성, 52주 범위)
    env_required:
    - REDIS_URL
    - POLYGON_API_KEY
    - FRED_API_KEY
    - ALPHA_VANTAGE_KEY
    data_contract:
      writes:
      - indicator:{SYM}:*
      - vol:{SYM}:*
      - price:{SYM}:Nd
      - price:{SYM}:high_52w
      reads:
      - price:{SYM}
      - champion:universe:global
  universe-sync-daemon:
    exec: /home/ubuntu/universe_sync_daemon.py
    interpreter: python3
    cwd: /home/ubuntu
    critical: true
    invariant_tags:
    - universe_sync
    description: 유니버스 키 동기화 데몬 (champion:universe:global 갱신)
    env_required:
    - REDIS_URL
    data_contract:
      writes:
      - champion:universe:global
      - emarkos:v1:universe:current
      reads:
      - policy:universe:active_profile
      - universe:*
  ares-invariant-guard:
    exec: /home/ubuntu/ares_current/ares_invariant_guard_v4.mjs
    interpreter: node
    cwd: /home/ubuntu/ares_current
    critical: true
    invariant_tags:
    - invariant_guard
    description: 시스템 불변 조건 감시 (Peak Monotonicity, 포지션 한도 등)
    env_required:
    - REDIS_URL
    data_contract:
      writes:
      - ares:invariant:guard:heartbeat
      reads:
      - ssot:target:v2:*
      - trading:enabled
  ares-self-healing-guard:
    exec: /home/ubuntu/ares_current/external/ares_self_healing_guard.py
    interpreter: python3
    cwd: /home/ubuntu/ares_current
    critical: false
    invariant_tags:
    - self_heal
    description: 자가 치유 가드
    env_required:
    - REDIS_URL
