# ============================================================================
# B05 Universe Synchronizer — 설정 템플릿 (v1.0.0)
# ============================================================================

redis:
  url: ""
  host: "127.0.0.1"
  port: 6379
  db: 0
  use_tls: false
  password_env: "ARES_REDIS_PASSWORD"
  password_file: ""
  socket_timeout_sec: 3.0
  socket_connect_timeout_sec: 3.0
  max_retries: 5
  retry_backoff_sec: 1.0

# SSOT 집합 키. userMemory 기준 "LIVE_UNI_60" 이 현재 캠페인의 유니버스 크기.
# 배포 시점에 실제 키 이름을 반드시 확인.
ssot_key: "LIVE_UNI_60"

# 각 프로세스가 자가 신고하는 집합 키의 패턴.
# 예: process:regime-consumer:universe, process:exec-sleeve-a:universe
process_key_pattern: "process:*:universe"
process_ts_suffix: ":ts"             # process:<n>:universe:ts (string, epoch ms)

# 이 시간 이상 신고가 없으면 해당 프로세스를 stale_report 로 마크
report_max_age_sec: 300

poll_interval_sec: 30
heartbeat_interval_sec: 30
report_ttl_sec: 120

log_level: "INFO"

# 필수: 기본값 true. 본 데몬은 어차피 write-only on addon:b05:* 이므로
# observe_only 는 문서적 신호.
observe_only: true
