    interpreter: python3
    env_file: /etc/ares/ares.env
    singleton: true
    critical: false
    invariant_tags: [sentinel]

  # === TIER 2: TRADING CONTROL (CRITICAL for market open) ===
  go-nogo-judge:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/go-nogo-judge-v2.mjs
    interpreter: node
    env_file: /etc/ares/ares.env
    singleton: true
    critical: true
    invariant_tags: [trading_control]

  kill-switch-authority-v2:
