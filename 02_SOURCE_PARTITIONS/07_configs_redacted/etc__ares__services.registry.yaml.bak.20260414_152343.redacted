services:
  # === TIER 1: CORE PIPELINE (already running) ===
  nextgen2-live:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/nextgen2/orchestrator.py
    interpreter: python3
    env_file: /etc/ares/ares.env
    singleton: true
    critical: true
    requires: [REDIS_URL, CANONICAL_ROOT]
    invariant_tags: [ssot_source, regime_producer]

  ssot-writer-v2:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/ops/ssot_writer_v2.py
    interpreter: python3
    env_file: /etc/ares/ares.env
    singleton: true
    critical: true
    invariant_tags: [ssot_writer]

  ssot-promote-v2:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/ops/ssot_promote_v2.py
    interpreter: python3
    env_file: /etc/ares/ares.env
    singleton: true
    critical: true
    invariant_tags: [ssot_promoter]

  live-trading-kis:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/live-trading-kis.mjs
    interpreter: node
    env_file: /etc/ares/ares.env
    singleton: true
    critical: true
    invariant_tags: [broker_executor, no_local_fallback]

  order-intent-executor:
    cwd: /home/ubuntu/ares_current
    exec: /home/ubuntu/ares_current/order-intent-executor.mjs
