# Canonical ARES environment file
APP_NAME=ares
APP_ENV=production
CANONICAL_ROOT=/home/ubuntu/ares_current
CANONICAL_SHARED=/etc/ares
CANONICAL_LOG_DIR=/var/log/ares
CANONICAL_RUN_DIR=/var/run/ares

# Redis must be TLS and must never point to localhost
REDIS_URL=rediss://***REDACTED***@master.ares-redis-ha.hgv1iy.apn2.cache.amazonaws.com:6379/0
ALLOW_LOCALHOST_REDIS=false
REQUIRE_REDIS_TLS=true

# Trading safety
SSOT_STALE_MAX_SECONDS=300
BRIDGE_REQUIRED=true
REQUIRE_SINGLE_INSTANCE=true
REQUIRE_CANONICAL_CWD=true
KILL_ON_INVARIANT_VIOLATION=true
BUY_FREEZE_KEY=***REDACTED***
TRADING_ENABLED_KEY=***REDACTED***

# Notifications / ops
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_BOT_TOKEN=
