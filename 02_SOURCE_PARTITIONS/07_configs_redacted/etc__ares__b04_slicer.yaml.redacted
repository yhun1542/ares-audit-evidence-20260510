# ============================================================================
# B04 TWAP/VWAP Smart Slicer — 설정 템플릿 (v1.0.0)
#
# 본 모듈은 권고만 발행. KIS API 호출 경로는 소스에 존재하지 않는다.
# ============================================================================

redis:
  url: ""
  host: "127.0.0.1"
  port: 6379
  db: 0
  use_tls: false
  password_env: "ARES_REDIS_PASSWORD"

# 대기 주문 스캔 패턴. EC2 실 스키마로 교체 필요.
orders_scan_pattern: "orders:pending:*"

# 심볼별 시장 데이터 키 패턴. {symbol} 은 런타임 치환.
adv_key_pattern: "market:adv:{symbol}"                   # 20일 평균 일거래량 (숫자)
price_key_pattern: "market:polygon:price:{symbol}"       # hash
price_field: "last_trade_price"
vol_key_pattern: "market:realized_vol_1m:{symbol}"       # 1분 realized vol (소수)
vwap_profile_key_pattern: "addon:b04:vwap_profile:{symbol}"  # JSON list

# 분할 정책
slice_min_frac: 0.01         # qty/ADV 가 1% 이상이면 slice
twap_slots: 10
twap_slot_sec: 60
vwap_slot_sec: 300
vwap_min_window_sec: 1800

# 가격 가드 (limit = last * (1 ± K*vol))
price_guard_k: 2.0

plan_ttl_sec: 3600
poll_interval_sec: 5
heartbeat_interval_sec: 30
max_scan: 2000

log_level: "INFO"

# 필수 유지: true
observe_only: true
