schema_version: 2026-05-06.health-watchdog.v1
defaults:
  max_staleness_s: 90
  max_pm2_restart_in_5m: 3
  severity: P0
guards:
  rt-position-guard-v9:
    health_keys:
    - ctx:rt-position-guard-v9:health
    - ctx:rt_guard:health
    max_staleness_s: 90
    parse_format: json_ms:ts
    severity: P0
    source:
      heartbeat_origin: ares-heartbeat-sidecar
  exposure-monitor:
    severity: P0
  trade-actuator-supervisor:
    health_keys:
    - trade-actuator-supervisor:heartbeat
    max_staleness_s: 60
    parse_format: ms_ts
    severity: P0
  kill-switch-authority:
    health_keys:
    - ctx:kill-switch-authority:health
    - kill-switch-authority:heartbeat
    max_staleness_s: 180
    parse_format: json_ms:ts
    severity: P0
    source:
      heartbeat_origin: ares-heartbeat-sidecar
    _config_note: '4AI review 2026-05-06: parse_format ms_ts->json_ms:ts (ctx key
      format), max_staleness_s 60->180 (장외시간 오탐 방지)'
  ares-upstream-ssot-router:
    health_keys:
    - ares-upstream-ssot-router:health
    max_staleness_s: 180
    parse_format: json:ts
    severity: P0
  ssot-pipeline-guard:
    severity: P0
    health_keys:
    - ctx:ssot-pipeline-guard:health
    parse_format: json_ms:ts
    max_staleness_s: 240
    source:
      heartbeat_origin: ares-heartbeat-sidecar
  realtime-data-feed-v3:
    max_pm2_restart_in_5m: 5
    severity: P0
    health_keys:
    - ctx:realtime-data-feed-v3:health
    parse_format: json_ms:ts
    max_staleness_s: 240
    source:
      heartbeat_origin: ares-heartbeat-sidecar
  kis-balance-sync:
    severity: P0
    health_keys:
    - ctx:kis-balance-sync:health
    parse_format: json_ms:ts
    max_staleness_s: 240
    source:
      heartbeat_origin: ares-heartbeat-sidecar
  kis-token-service:
    severity: P0
    health_keys:
    - ctx:kis-token-service:health
    parse_format: json_ms:ts
    max_staleness_s: 240
    source:
      heartbeat_origin: ares-heartbeat-sidecar
  ssot-writer-v2:
