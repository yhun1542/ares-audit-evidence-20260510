{
  "apps": [{
    "name": "ssot-audit-alert-daemon",
    "script": "/home/ubuntu/ares_current/ops/ssot_audit_alert_daemon.py",
    "interpreter": "/usr/bin/python3",
    "exec_mode": "fork",
    "instances": 1,
    "autorestart": true,
    "max_restarts": 10,
    "min_uptime": "30s",
    "max_memory_restart": "256M",
    "env": {
      "ALERT_POLL_INTERVAL_SEC": "30",
      "ALERT_WINDOW_SEC": "600",
      "ALERT_MAX_PROMOTE_PER_WIN": "30",
      "ALERT_MAX_REJECT_PER_WIN": "3",
      "ALERT_LOG_PATH": "/var/log/ares/ssot_audit_alerts.log",
      "ALERT_SLACK_ENV": "ARES_SLACK_WEBHOOK"
    }
  }]
}
